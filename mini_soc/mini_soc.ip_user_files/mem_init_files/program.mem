// =========================================================================
// PHASE 1: CH? B?T UART (SPI, I2C t?t clock)
// =========================================================================
60000537          // lui x10, 0x60000      ; Base PMU
00100593          // addi x11, x0, 1       ; bit[2:0] = 3'b001 (Ch? UART = 1)
00b52023          // sw x11, 0(x10)        ; Ghi vào PMU
40000537          // lui x10, 0x40000      ; Base UART
04100593          // addi x11, x0, 65      ; Data 'A'
00b52023          // sw x11, 0(x10)        ; Ghi UART TX
// (Thêm các l?nh ??c tr? tùy ý t?i ?ây...)

// =========================================================================
// PHASE 2: CH? B?T SPI (UART b? ng?t clock v?ng ra, I2C t?t)
// =========================================================================
60000537          // lui x10, 0x60000      ; Base PMU
00200593          // addi x11, x0, 2       ; bit[2:0] = 3'b010 (Ch? SPI = 1, UART v? 0)
00b52023          // sw x11, 0(x10)        ; Ghi vào PMU -> SPI b?t, UART ng? ?ông!
40001537          // lui x10, 0x40001      ; Base SPI
05500593          // addi x11, x0, 85      ; Data 0x55
00b52023          // sw x11, 0(x10)        ; Ghi SPI TX
00100593          // addi x11, x0, 1       ; START
00b52623          // sw x11, 12(x10)       ; Kích SPI

// =========================================================================
// PHASE 3: CH? B?T I2C (UART, SPI t?t clock)
// =========================================================================
60000537          // lui x10, 0x60000      ; Base PMU
00400593          // addi x11, x0, 4       ; bit[2:0] = 3'b100 (Ch? I2C = 1, SPI v? 0)
00b52023          // sw x11, 0(x10)        ; Ghi vào PMU -> I2C b?t, SPI ng? ?ông!
40002537          // lui x10, 0x40002      ; Base I2C
0aa00593          // addi x11, x0, 170     ; Data 0xAA
00b52023          // sw x11, 0(x10)        ; Ghi I2C TX
00100593          // addi x11, x0, 1       ; START
00b52623          // sw x11, 12(x10)       ; Kích I2C

fe000ce3          // beq x0, x0, -4        ; Loop k?t thúc